{
  "name": "vulkan2",
  "version-string": "0.1.0",
  "dependencies": [
    "glm",
    "vk-bootstrap",
    "vulkan-memory-allocator",
	"fmt",
	"fastgltf",
	"stb",
	{
	  "name": "imgui",
	  "default-features": true,
	  "features": [
	    "sdl3-binding",
		"vulkan-binding"
	  ]
	},
    {
      "name": "sdl3",
      "default-features": true,
      "features": [
        "vulkan"
      ]
    }
  ]
}
