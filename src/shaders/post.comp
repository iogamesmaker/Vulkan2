#version 450
// HDR post processing: exposure (auto, exposure.comp) + bloom + tonemapping + a light grade, in place on the output
// image

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, set = 0, binding = 0) uniform image2D image;

layout(std430, set = 0, binding = 4) readonly buffer Exposure { float autoExposure; }; // exposure.comp
layout(set = 0, binding = 5) uniform sampler2D bloomTexture; // bloom.comp, mip 0 is half resolution

layout(push_constant) uniform constants { // PostPushConstants (atmosphere.hpp), shared with exposure.comp
	float exposure;		 // compensation (2^EV) on top of the automatic exposure
	float deltaTime;	 // exposure.comp's
	float bloomStrength; // the mix of the bloom chain, energy conserving
	float time;			 // seconds, wraps (the film grain moves)
} pc;

// ACES fitted to the RRT + ODT (Stephen Hill, BakingLab). unlike the single curve approximation it works in the
// ACES working space, so bright colours roll off towards white keeping their hue instead of clipping per channel
// (which turned sunlit grass and sand into flat yellow)
const mat3 ACES_INPUT = mat3(
	0.59719, 0.07600, 0.02840,
	0.35458, 0.90834, 0.13383,
	0.04823, 0.01566, 0.83777);
const mat3 ACES_OUTPUT = mat3(
	 1.60475, -0.10208, -0.00327,
	-0.53108,  1.10813, -0.07276,
	-0.07367, -0.00605,  1.07602);

vec3 tonemapACES(vec3 color) {
	vec3 v = ACES_INPUT * color;
	v = (v * (v + 0.0245786) - 0.000090537) / (v * (0.983729 * v + 0.4329510) + 0.238081);
	return clamp(ACES_OUTPUT * v, 0.0, 1.0);
}

// the look, a filmic grade in two halves. on the scene (linear, before the curve): greens pulled towards olive
// and a little less saturated (a meadow was one flat bright green, nature's greens are yellowish and muted), the
// whole image a touch less saturated and a touch warm, like daylight film
vec3 gradeScene(vec3 c) {
	float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
	float green = clamp((c.g - max(c.r, c.b)) / max(c.g, 1e-5) * 2.5, 0.0, 1.0); // how much it leans green
	c.r = mix(c.r, c.g * 0.85, green * 0.18);
	c = mix(vec3(luma), c, 1.0 - green * 0.12);
	return max(c * vec3(1.03, 1.0, 0.96), 0.0); // (a touch warm; more and every sunrise was a red wash)
}

// on the display referred image: cool shadows and warm highlights (split toning), a gentle S curve around the
// mid tones, and lifted, slightly warm blacks (a film print's fade: nothing goes to pure black)
vec3 gradeDisplay(vec3 c) {
	float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
	c *= mix(vec3(0.96, 1.0, 1.05), vec3(1.04, 1.0, 0.93), smoothstep(0.08, 0.75, luma));
	c = clamp(c, 0.0, 1.0);
	c = mix(c, c * c * (3.0 - 2.0 * c), 0.28);
	// warm light, rich in the highlights: a little more saturation as it gets brighter
	float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
	c = mix(vec3(l), c, mix(1.04, 1.18, smoothstep(0.25, 0.75, l)));
	return clamp(c, 0.0, 1.0) * 0.988 + vec3(0.004, 0.005, 0.008);
}

// the swapchain is UNORM, so the sRGB encoding happens here (the real curve, not a 2.2 power)
vec3 linearToSRGB(vec3 c) {
	return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}

vec3 tonemap(vec3 hdr) {
	return linearToSRGB(clamp(gradeDisplay(tonemapACES(gradeScene(hdr))), 0.0, 1.0));
}

// a fine film grain on the encoded image, stronger in the darks (where film shows it), new every frame
float grain(ivec2 p) {
	vec3 p3 = fract(vec3(vec2(p), pc.time * 60.0) * vec3(0.1031, 0.1030, 0.0973));
	p3 += dot(p3, p3.yxz + 33.33);
	return fract((p3.x + p3.y) * p3.z) - 0.5;
}

void main() {
	ivec2 texcoord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(image);
	if (texcoord.x >= size.x || texcoord.y >= size.y) return;

	vec3 color = imageLoad(image, texcoord).rgb;

	// bloom: a wide glow around everything bright, mixed in (energy conserving) before the exposure
	vec3 bloom = textureLod(bloomTexture, (vec2(texcoord) + 0.5) / vec2(size), 0.0).rgb;
	color = mix(color, bloom, pc.bloomStrength);

	vec3 display = tonemap(color * autoExposure * pc.exposure);
	float luma = dot(display, vec3(0.2126, 0.7152, 0.0722));
	display += grain(texcoord) * 0.016 * (1.0 - luma * 0.7);
	imageStore(image, texcoord, vec4(display, 1.0));
}
