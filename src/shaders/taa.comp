#version 450
// temporal anti-aliasing + upscaling (TSR): the scene is rendered at the render scale with a sub pixel jitter that
// walks a 16 step Halton pattern, this rebuilds the image at the OUTPUT resolution from the current jittered frame
// and the reprojected output resolution history. at render scale 1 it's plain TAA, below 1 the history gathers the
// detail of 16 differently jittered frames. runs on the HDR image, before bloom / exposure / tonemapping.
// anti-ghosting:
//   - depth dilated motion: each pixel reprojects with the closest surface in its 3x3 neighbourhood, so moving
//     edges (foliage in front of the sky, a trunk against the terrain) don't leave the background's history trails
//   - variance clipping of the history in YCoCg against the current neighbourhood, tighter while things move
//   - history that had to be clipped far (a disocclusion / something new) is trusted less for a while
//   - more of the current frame while the pixel moves fast (motion blurs the history anyway)
//   - the current sample's weight follows how close the jittered low res sample lands to the output pixel, so the
//     upscale only takes what the frame actually saw there

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D current;				   // this frame, render resolution, jittered (linear)
layout(set = 0, binding = 1) uniform sampler2D history;				   // last frame's result, output resolution (linear)
layout(rgba16f, set = 0, binding = 2) uniform writeonly image2D result;  // output resolution, becomes next frame's history
layout(set = 0, binding = 3) uniform sampler2D depthBuffer;			   // render resolution
layout(set = 0, binding = 4) uniform sampler2D velocityBuffer;		   // render resolution: the wind's own motion (uv), 0 for static things

layout(push_constant) uniform constants {
	mat4 reproject;	  // current unjittered NDC -> last frame's unjittered clip space
	float blend;	  // the current frame's share at rest, ~0.1
	int historyValid; // 0 after a resize / the first frame
	vec2 jitter;	  // this frame's jitter, render resolution pixels
} pc;

vec3 toYCoCg(vec3 c) { return vec3(dot(c, vec3(0.25, 0.5, 0.25)), dot(c, vec3(0.5, 0.0, -0.5)), dot(c, vec3(-0.25, 0.5, -0.25))); }
vec3 fromYCoCg(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

// compresses HDR so a few very bright pixels can't dominate the blend (and the neighbourhood statistics)
vec3 compress(vec3 c) { return c / (1.0 + max(c.r, max(c.g, c.b))); }
vec3 uncompress(vec3 c) { return c / max(1.0 - max(c.r, max(c.g, c.b)), 1e-4); }

// Catmull-Rom in 5 bilinear taps (Jimenez 2016): sharper than bilinear, which would blur a little more every frame
vec3 sampleCatmullRom(sampler2D tex, vec2 uv, vec2 size) {
	vec2 position = uv * size;
	vec2 center = floor(position - 0.5) + 0.5;
	vec2 f = position - center;
	vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
	vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
	vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
	vec2 w3 = f * f * (-0.5 + 0.5 * f);
	vec2 w12 = w1 + w2;
	vec2 tc0 = (center - 1.0) / size, tc3 = (center + 2.0) / size, tc12 = (center + w2 / w12) / size;
	vec3 c = texture(tex, vec2(tc12.x, tc0.y)).rgb * (w12.x * w0.y)
		   + texture(tex, vec2(tc0.x, tc12.y)).rgb * (w0.x * w12.y)
		   + texture(tex, vec2(tc12.x, tc12.y)).rgb * (w12.x * w12.y)
		   + texture(tex, vec2(tc3.x, tc12.y)).rgb * (w3.x * w12.y)
		   + texture(tex, vec2(tc12.x, tc3.y)).rgb * (w12.x * w3.y);
	float weight = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
	return max(c / weight, 0.0);
}

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 outSize = imageSize(result);
	if (any(greaterThanEqual(p, outSize))) return;
	vec2 inSize = vec2(textureSize(current, 0));
	ivec2 inMax = ivec2(inSize) - 1;

	// where this output pixel is in the render resolution frame: unjittered position, and where the jittered
	// render put that point (the jitter moved the image by +jitter pixels)
	vec2 uv = (vec2(p) + 0.5) / vec2(outSize);
	vec2 inPos = uv * inSize;
	vec2 jittered = inPos + pc.jitter;
	ivec2 centre = clamp(ivec2(floor(jittered)), ivec2(0), inMax);

	// the current frame, Catmull-Rom at the jittered position = the scene at this output pixel's centre
	vec3 color = sampleCatmullRom(current, jittered / inSize, inSize);

	// the 3x3 render resolution neighbourhood: colour statistics (YCoCg, compressed) for the clipping, and the
	// closest depth (reversed z: the biggest) for the motion
	vec3 m1 = vec3(0.0), m2 = vec3(0.0);
	float closestDepth = 0.0;
	ivec2 closest = centre;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			ivec2 q = clamp(centre + ivec2(x, y), ivec2(0), inMax);
			vec3 c = toYCoCg(compress(texelFetch(current, q, 0).rgb));
			m1 += c;
			m2 += c * c;
			float d = texelFetch(depthBuffer, q, 0).r;
			if (d > closestDepth) { closestDepth = d; closest = q; }
		}
	}
	m1 /= 9.0;
	vec3 sigma = sqrt(max(m2 / 9.0 - m1 * m1, 0.0));

	// where this pixel was last frame: the camera reprojection of the closest surface around it, plus that
	// surface's own motion (the wind)
	vec4 previousClip = pc.reproject * vec4(uv * 2.0 - 1.0, closestDepth, 1.0);
	vec2 previousUV = previousClip.xy / previousClip.w * 0.5 + 0.5;
	vec2 velocity = texelFetch(velocityBuffer, closest, 0).rg;
	previousUV -= velocity;
	float speed = length((uv - previousUV) * vec2(outSize)); // output pixels moved since last frame

	// how close the jittered sample this pixel sees lands to its centre (render resolution pixels): the upscale
	// only gathers what the frame actually saw here, far samples count less
	vec2 sampleOffset = (vec2(centre) + 0.5 - pc.jitter) - inPos;
	float sampleWeight = exp(-2.5 * dot(sampleOffset, sampleOffset));

	vec3 resolved = color;
	bool inside = all(greaterThanEqual(previousUV, vec2(0.0))) && all(lessThanEqual(previousUV, vec2(1.0)));
	if (pc.historyValid != 0 && inside) {
		vec3 previous = toYCoCg(compress(sampleCatmullRom(history, previousUV, vec2(outSize))));
		// the clipping box: tighter while it moves (ghosts show most there), wider at rest (less flicker)
		float gamma = mix(1.25, 0.85, smoothstep(0.5, 6.0, speed));
		vec3 boxMin = m1 - sigma * gamma, boxMax = m1 + sigma * gamma;
		vec3 boxCentre = (boxMin + boxMax) * 0.5, extents = max((boxMax - boxMin) * 0.5, 1e-5);
		vec3 offset = previous - boxCentre;
		float outside = max(abs(offset.x / extents.x), max(abs(offset.y / extents.y), abs(offset.z / extents.z)));
		if (outside > 1.0) previous = boxCentre + offset / outside; // towards the box centre: keeps the hue

		// the current frame's share: the base, more where the sample is close to the pixel centre, more when the
		// history had to be clipped far (something new is there), more when it moves fast
		float alpha = pc.blend * mix(0.35, 1.25, sampleWeight);
		alpha = max(alpha, smoothstep(1.5, 4.0, outside) * 0.5);
		alpha = max(alpha, smoothstep(2.0, 20.0, speed) * 0.35);
		vec3 currentYC = toYCoCg(compress(color));
		resolved = uncompress(fromYCoCg(mix(previous, currentYC, clamp(alpha, 0.0, 1.0))));
	}
	imageStore(result, p, vec4(resolved, 1.0));
}
