#version 450
// temporal accumulation for the volumetric clouds (half resolution): clouds.comp's march is 32 steps through up to
// 20km of cloud with a new random start every frame, alone it's very noisy and the TAA's clamp lets most of that
// noise through (it shimmered). here each pixel blends into last frame's result, reprojected, after clamping that
// to what the march found around it this frame (so moving clouds and things passing in front don't smear)
// rgb = in-scattered light, a = transmittance (clouds.comp)

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D current;	   // this frame's march (half resolution)
layout(set = 0, binding = 1) uniform sampler2D history;	   // last frame's result, linear filtered, clamped
layout(set = 0, binding = 2) uniform sampler2D depthBuffer;   // full resolution
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D resolved;
layout(set = 0, binding = 4) uniform sampler2D historyDepth;  // the scene depth each texel was marched to last frame
layout(r32f, set = 0, binding = 5) uniform writeonly image2D resolvedDepth; // this frame's, for the next

layout(push_constant) uniform constants {
	mat4 reproject;	  // this frame's NDC (as clouds.comp marched it) -> last frame's clip
	float valid;	  // 0: no history (first frame, resize, clouds just turned on)
	float blend;	  // how much of this frame goes in
	vec2 pad;
} pc;

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(resolved);
	if (any(greaterThanEqual(p, size))) return;

	vec4 now = texelFetch(current, p, 0);
	vec2 fullSize = vec2(textureSize(depthBuffer, 0));
	ivec2 ratio = max(ivec2(round(fullSize / vec2(size))), ivec2(1)); // half resolution, or full (Ultra)
	ivec2 full = p * ratio;
	vec2 uv = (vec2(full) + 0.5) / fullSize;
	float depth = texelFetch(depthBuffer, full, 0).r;
	imageStore(resolvedDepth, p, vec4(depth));
	if (pc.valid < 0.5) { imageStore(resolved, p, now); return; }
	float viewZ = 0.02 / max(depth, 1e-7); // reversed z, ~ view distance (the sky: huge)

	// the neighbourhood (3x3, only the texels at this one's depth: along an edge the sky's rays and the ones stopped by
	// a tree or a ridge are very different, together they opened the box so wide the march's noise went straight
	// through). its tent weighted mean is also a spatially filtered version of this frame, blended in instead of the
	// raw march: a third of the noise before the history even starts. the depth tolerance is 10%: at 3% a grazing
	// slope's neighbours all fell out, the box shrank to this texel alone and nothing accumulated (blotchy far fog)
	vec4 m1 = vec4(0.0), m2 = vec4(0.0);
	float wSum = 0.0;
	bool openSky = true; // all 9 the sky
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			ivec2 q = clamp(p + ivec2(x, y), ivec2(0), size - 1);
			float qDepth = texelFetch(depthBuffer, q * ratio, 0).r;
			openSky = openSky && qDepth <= 0.0;
			float z = 0.02 / max(qDepth, 1e-7);
			float tent = (x == 0 ? 2.0 : 1.0) * (y == 0 ? 2.0 : 1.0);
			float w = tent * ((x == 0 && y == 0) ? 1.0 : exp(-abs(z - viewZ) / (viewZ * 0.1)));
			vec4 c = texelFetch(current, q, 0);
			m1 += c * w;
			m2 += c * c * w;
			wSum += w;
		}
	}
	m1 /= wSum;
	vec4 sigma = sqrt(max(m2 / wSum - m1 * m1, 0.0));
	// the open sky: the reprojection is exact (only the camera's rotation, the clouds kilometres away and drifting
	// slowly) and nothing can be uncovered, so hardly a clamp at all. the box is built from this frame's noisy march, along
	// a cloud's edge it jumped about every frame and dragged the history along: the edges flickered, even holding 100
	// frames. (a lightning flash drops the history, application.cpp.) next to the land or over it the parallax can
	// uncover something: clamped there, never zero wide (a flat neighbourhood clamped the history to this frame's noise)
	bool sky = openSky;
	vec4 box = sigma * 2.0 + vec4(vec3(0.02 * max(max(m1.r, m1.g), m1.b)), 0.02);
	// (only a very loose box in the open sky: flying fast through the clouds still has parallax up there)
	if (sky) box = sigma * 6.0 + vec4(vec3(0.15 * max(max(m1.r, m1.g), m1.b)), 0.15);
	vec4 low = m1 - box, high = m1 + box;

	// where this pixel's ray was last frame (the clouds sit kilometres away, the scene's depth where it's in front)
	vec4 previousClip = pc.reproject * vec4(uv * 2.0 - 1.0, depth > 0.0 ? depth : 1e-5, 1.0);
	vec2 previousUV = previousClip.xy / previousClip.w * 0.5 + 0.5;
	vec4 filtered = mix(now, m1, 0.6);
	if (previousClip.w <= 0.0 || any(lessThan(previousUV, vec2(0.0))) || any(greaterThan(previousUV, vec2(1.0)))) {
		imageStore(resolved, p, filtered);
		return;
	}
	// (texel q holds the ray through full resolution pixel q * ratio, not the texel's centre: read as if it were the
	// history came a quarter texel off every frame, it crept and blurred, and the box fought it along every edge)
	// bilinear by hand over the 4 history texels, each only if it was marched to what's here now: where this pixel
	// sees the sky, a texel that last frame stopped at a tree (or the other way round) is something else. without
	// this a tree walking past in front of the clouds left its silhouette in them for a second (the sky's box is
	// loose, nothing else threw it out)
	float expectedZ = depth > 0.0 ? 0.02 / max(previousClip.z / previousClip.w, 1e-7) : 1e30; // where it was last frame
	vec2 texel = (previousUV * fullSize - 0.5) / vec2(ratio); // in texels, centres at whole numbers
	ivec2 base = ivec2(floor(texel));
	vec2 f = texel - vec2(base);
	vec4 historySum = vec4(0.0);
	float historyWeight = 0.0;
	for (int i = 0; i < 4; i++) {
		ivec2 o = ivec2(i & 1, i >> 1);
		ivec2 q = clamp(base + o, ivec2(0), size - 1);
		float d = texelFetch(historyDepth, q, 0).r;
		float z = d > 0.0 ? 0.02 / max(d, 1e-7) : 1e30;
		bool same = (z >= 1e29) == (expectedZ >= 1e29) && (z >= 1e29 || abs(log(z / expectedZ)) < 0.7); // within 2x: a tree 10m off vs the sky or a ridge, not a slope's
		// neighbouring texels (the TAA's jitter moved those in and out of a tight match: flicker)
		float w = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
		if (same && w > 0.0) {
			historySum += texelFetch(history, q, 0) * w;
			historyWeight += w;
		}
	}
	if (historyWeight < 0.05) { // all of it something else: start over from this frame
		imageStore(resolved, p, filtered);
		return;
	}
	vec4 before = clamp(historySum / historyWeight, low, high);
	// partly something else (an edge just uncovered): this frame counts for more until it has settled
	float blend = sky ? pc.blend * 0.6 : pc.blend;
	blend = mix(0.3, blend, historyWeight);
	// (the sky holds ~20 frames, the land ~12: nothing moves fast up there, and the cloud edges are where a march
	// either catches a thin wisp or skips it, the most noise to average)
	imageStore(resolved, p, mix(before, filtered, blend));
}
