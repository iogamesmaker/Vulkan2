#version 450
// the volumetric cumulus at half resolution (they're soft anyway, TAA smooths the jittered march): one ray per 2x2
// pixels, up to the scene's depth (or the sky). lighting.comp upsamples it depth aware and composites it over the
// lit scene and the sky. rgb = the light scattered towards the camera, a = how much of what's behind gets through

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depthBuffer;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D cloudImage;
layout(set = 0, binding = 2) uniform sampler3D cloudNoiseLUT; // cloudnoise.comp, tiles

layout(set = 1, binding = 0) uniform sampler2D transmittanceLUT;
layout(set = 1, binding = 2) uniform sampler2D skyviewLUT;
#define ATMOSPHERE_SET 1
#define ATMOSPHERE_BINDING 4
#include "atmosphere.glsl"
layout(set = 0, binding = 3) uniform sampler2D cloudCoverageMap; // cloudmap.comp
layout(std140, set = 0, binding = 4) uniform CloudMapInfo { vec4 cloudMapInfo; }; // xy centre (km), z extent, w valid
#define CLOUD_COVERAGE_MAP
#include "clouds.glsl"
#define CLOUD_NOISE_LUT cloudNoiseLUT
#include "volclouds.glsl"

layout(push_constant) uniform constants {
	mat4 invViewProj; // terrain space
	vec3 campos;
	float frame;
	vec3 sundir;
	float terrainSize;
	vec2 cloudWind;
	vec2 mapOffset; // texels of the 4096 heightmap (heightmapscale.glsl), whatever its size
} pc;

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(cloudImage);
	if (any(greaterThanEqual(p, size))) return;

	vec2 fullSize = vec2(textureSize(depthBuffer, 0));
	ivec2 full = p * max(ivec2(round(fullSize / vec2(size))), ivec2(1)); // half resolution, or full (Ultra)
	vec2 uv = (vec2(full) + 0.5) / fullSize;
	float depth = texelFetch(depthBuffer, full, 0).r;
	vec4 farPoint = pc.invViewProj * vec4(uv * 2.0 - 1.0, depth > 0.0 ? depth : 1e-5, 1.0);
	vec3 target = farPoint.xyz / farPoint.w;
	vec3 dir = normalize(target - pc.campos);
	float tMax = depth > 0.0 ? distance(target, pc.campos) * ubo.worldScale : 1e6; // km

	// the camera's real altitude, not clamped at "sea level" like the atmosphere lookups: the low terrain sits below
	// it (down to ~-2km), clamping froze the clouds in place until you climbed past it
	vec3 camKm = vec3(0.0, ubo.radiusbottom + ubo.baseAltitude + pc.campos.y * ubo.worldScale, 0.0);
	vec2 camWorldKm = (pc.campos.xz + pc.mapOffset * (pc.terrainSize / 4096.0)) * ubo.worldScale; // pc.mapOffset's unit
	float jitter = fract(52.9829189 * fract(dot(vec2(p) + pc.frame * 5.588238, vec2(0.06711056, 0.00583715))));
	vec4 cloud = marchCumulus(transmittanceLUT, skyviewLUT, camKm, camWorldKm, pc.cloudWind, dir, tMax, pc.sundir, jitter);
	imageStore(cloudImage, p, vec4(cloud.rgb, 1.0 - cloud.a)); // (marchCumulus returns it premultiplied)
}
