#version 450
// scatters the ground cover (ferns, bushes, flowers, nettles, weeds, dead branches, clover) on three world anchored
// grids around the camera every frame, like the grass and the props: the big shrubs on a coarse grid out to ~150m,
// the medium plants on a finer one out to ~60m, the small ones on a fine grid close by. one plant per cell at most,
// picked by what the ground is (forest floor, meadow, damp, forest edge), in patches. binned per mesh for indexed
// indirect draws, plus shadow casters near the camera.
// no popping: every plant has its own distance it reaches out to (spread out, so the density thins smoothly) and
// shrinks away over the last part of it; its variant never changes with distance, the dense variants just reach
// less far than the light ones

layout(local_size_x = 64) in;

#include "groundcovercommon.glsl"
#include "biometools.glsl"
#include "terrainheight.glsl"

layout(set = 0, binding = 0) uniform sampler2D heightmap;
layout(set = 0, binding = 1) uniform sampler2D climateMap; // half resolution
layout(std430, set = 0, binding = 2) writeonly buffer Instances { GroundCoverInstance instances[]; };
struct DrawCommand { uint indexCount; uint instanceCount; uint firstIndex; int vertexOffset; uint firstInstance; };
// [0, GC_MAX_MESHES) what the camera sees, per mesh, then the same for the shadow casters
layout(std430, set = 0, binding = 3) buffer Commands { DrawCommand commands[GC_MAX_MESHES * 2]; };
layout(std430, set = 0, binding = 4) readonly buffer Species { GroundCoverSpecies species[GC_SPECIES]; };

void append(uint bin, GroundCoverInstance instance) {
	uint slot = atomicAdd(commands[bin].instanceCount, 1u);
	if (slot >= GC_CAPACITY) { atomicAdd(commands[bin].instanceCount, uint(-1)); return; }
	instances[bin * GC_CAPACITY + slot] = instance;
}

// slow patches (world units), so the plants grow in clusters and clearings instead of an even sprinkle
float patches(vec2 world, float scale, float seed) {
	return lineValueNoise(world / scale + seed * 37.0) * 0.7 + lineValueNoise(world / (scale * 0.37) - seed * 11.0) * 0.3;
}

void main() {
	uint id = gl_GlobalInvocationID.x;
	// the grids are consecutive thread ranges: small, medium, far
	uint grid = 0u, local = id;
	for (; grid < 2u && local >= GC_SIDE[grid] * GC_SIDE[grid]; grid++) local -= GC_SIDE[grid] * GC_SIDE[grid];
	uint side = GC_SIDE[grid];
	if (local >= side * side) return;
	float cell = GC_CELL[grid];
	float radius = GC_RADIUS[grid];

	vec2 camWorld = pc.campos.xz + pc.offsetWorld;
	vec2 cellIndex = floor(camWorld / cell) - float(side / 2u) + vec2(local % side, local / side);
	vec4 rnd = hash42(cellIndex * 1.37 + float(grid) * 41.0 + 13.0);
	vec4 rnd2 = hash42(cellIndex * 0.61 - float(grid) * 23.0 - 47.0);
	vec2 world = (cellIndex + 0.1 + rnd.xy * 0.8) * cell;
	vec2 xz = world - pc.offsetWorld;
	float distXZ = distance(xz, pc.campos.xz);
	if (distXZ > radius) return;

	vec2 size = vec2(textureSize(heightmap, 0));
	vec2 uv = heightmapUV(xz, size);
	vec4 data = vec4(textureLod(climateMap, uv, 0.0).rgb, textureLod(heightmap, uv, 0.0).a); // climate, height
	float roughY = data.a * pc.factor - pc.factor * 0.5;
	float dist = length(vec2(distXZ, roughY - pc.campos.y));
	if (dist > radius) return;

	// nothing on stone, thinning towards it and the snow (the same masks as the grass, biometools.glsl)
	float hR = textureLodOffset(heightmap, uv, 0.0, ivec2(1, 0)).a, hL = textureLodOffset(heightmap, uv, 0.0, ivec2(-1, 0)).a;
	float hT = textureLodOffset(heightmap, uv, 0.0, ivec2(0, 1)).a, hB = textureLodOffset(heightmap, uv, 0.0, ivec2(0, -1)).a;
	float slope = pow((hR - hL) * heightmapSlopeScale(size.x), 2.0) + pow((hT - hB) * heightmapSlopeScale(size.x), 2.0);
	float mountains = mountainWeight(data.rgb);
	GroundBareness ground = groundBareness(uv, data, slope);
	if (ground.stone > 0.2 || ground.bare > 0.85) return;
	float bare = ground.bare;

	float weights[BIOME_COUNT];
	groundCover(data.rgb, true, weights);
	float barren = smoothstep(0.1, 0.3, weights[BIOME_DESERT] + weights[BIOME_SNOW]);
	float field = smoothstep(0.35, 0.5, weights[BIOME_WHEAT] * (1.0 - mountains));
	float alive = (1.0 - barren) * (1.0 - field) * (1.0 - smoothstep(0.5, 0.9, bare)) * pc.interaction; // * the density setting
	if (alive <= 0.0) return;
	// forest floor: where the trees actually grow (the same chances they're placed by, biometools.glsl). the rest
	// is open grassland (alpine meadows too): rock, snow, sand and fields are already masked out by alive
	vec3 trees = treeChances(data, 0.0, 1.0);
	float forest = smoothstep(0.08, 0.45, trees.x + trees.y);
	float meadow = 1.0 - forest;
	float damp = smoothstep(0.45, 0.75, data.g);
	// forest edges: where the forest thins into the meadow the bushes and nettles crowd
	float edge = forest * meadow * 4.0;

	// chances per cell (small cells ~0.1 m^2, medium ~0.8 m^2, far ~3.2 m^2)
	float chance[GC_SPECIES];
	for (int i = 0; i < GC_SPECIES; i++) chance[i] = 0.0;
	if (grid == 0u) {
		chance[GC_SORREL] = (forest * 0.3 + meadow * 0.15) * mix(0.2, 1.8, patches(world, 0.6, 6.0));
		chance[GC_WEED] = (meadow * 0.15 + forest * 0.05) * mix(0.3, 1.7, patches(world, 0.8, 7.0));
		chance[GC_DANDELION] = meadow * 0.07 * smoothstep(0.4, 0.75, patches(world, 1.0, 8.0)) * 2.5;
	} else if (grid == 1u) {
		chance[GC_FERN] = (forest * 0.55 + meadow * damp * 0.08 + edge * 0.15) * mix(0.15, 1.8, smoothstep(0.3, 0.7, patches(world, 2.0, 1.0)));
		chance[GC_BRANCHES] = forest * 0.04;
		chance[GC_BUSH] = (forest * 0.1 + meadow * 0.08 + edge * 0.1) * mix(0.2, 1.8, patches(world, 1.5, 3.0));
		chance[GC_NETTLE] = (meadow * damp * 0.1 + forest * damp * 0.05 + edge * 0.1) * smoothstep(0.35, 0.65, patches(world, 1.2, 4.0)) * 2.0;
		chance[GC_PERIWINKLE] = forest * 0.16 * smoothstep(0.35, 0.65, patches(world, 1.0, 5.0)) * 2.0;
		// the flowers: drifts of one colour each in the meadows (a few at the forest edges), ~10m patches
		chance[GC_GAZANIA] = meadow * 0.3 * smoothstep(0.4, 0.65, patches(world, 1.6, 9.0)) * (1.0 - damp * 0.5);
		chance[GC_URSINIA] = (meadow * 0.28 + edge * 0.05) * smoothstep(0.4, 0.65, patches(world, 1.4, 10.0));
		chance[GC_EMPODIUM] = (meadow * 0.22 + edge * 0.1) * smoothstep(0.4, 0.65, patches(world, 1.2, 11.0));
		chance[GC_STINKKRUID] = meadow * 0.2 * smoothstep(0.45, 0.7, patches(world, 1.8, 12.0)) * (1.0 - damp * 0.6);
	} else {
		// the big shrubs, far out: thickets at the forest edges, a few in the woods and out in the meadows
		chance[GC_SHRUB] = (forest * 0.1 + meadow * 0.06 + edge * 0.3) * mix(0.2, 1.8, patches(world, 3.0, 2.0));
		chance[GC_ROOIBOS] = (meadow * 0.15 + edge * 0.2 + forest * 0.03) * mix(0.2, 1.8, patches(world, 2.5, 13.0));
	}

	float total = 0.0;
	for (int i = 0; i < GC_SPECIES; i++) total += chance[i] * alive;
	float roll = rnd.z * max(total, 1.0);
	int kind = -1;
	float sum = 0.0;
	for (int i = 0; i < GC_SPECIES; i++) {
		sum += chance[i] * alive;
		if (roll < sum) { kind = i; break; }
	}
	if (kind < 0) return;
	GroundCoverSpecies sp = species[kind];
	if (sp.meshes.y == 0u) return;

	// its variant: fixed per plant (the variants are sorted lightest first)
	uint variant = min(uint(rnd.w * float(sp.meshes.y)), sp.meshes.y - 1u);
	uint mesh = sp.meshes.x + variant;
	// how far this one plant shows: spread between a part of its kind's reach and all of it, so the plants thin out
	// gradually with distance. the dense variants (the upper half) reach half as far, they're small on screen
	// out there and the triangles add up
	const float reach[GC_SPECIES] = float[](8.0, 6.0, GC_RADIUS_FAR, 6.0, 5.0, 4.0, GC_RADIUS_SMALL, GC_RADIUS_SMALL, GC_RADIUS_SMALL,
											 8.0, 7.0, 6.0, 7.0, 16.0); // (the flowers are cheap, their colour carries)
	float keep = hash42(cellIndex * 0.83 + float(grid) * 7.0 + 5.0).x;
	float plantReach = reach[kind] * mix(0.45, 1.0, keep * keep);
	if (sp.meshes.y > 1u && variant >= (sp.meshes.y + 1u) / 2u) plantReach *= 0.5;
	// shrinks away over the last quarter of its distance instead of popping out
	float fade = 1.0 - smoothstep(plantReach * 0.75, plantReach, dist);
	if (fade < 0.03) return;

	// the models are real world size (metres, GroundCover::init converts to world units), a bit of variation
	// on top. some are scaled up: the nettles, clover and some flowers in the downloads are seedlings
	const float minScale[GC_SPECIES] = float[](1.8, 0.8, 1.2, 1.4, 2.6, 0.9, 1.6, 1.2, 1.0, 2.6, 3.6, 2.4, 3.6, 2.2);
	const float maxScale[GC_SPECIES] = float[](3.2, 1.2, 2.0, 2.4, 4.0, 1.4, 2.4, 1.8, 1.3, 4.0, 5.0, 3.4, 5.0, 3.6);
	float scale = mix(minScale[kind], maxScale[kind], rnd2.x) * fade;

	float groundY = terrainHeight(heightmap, uv, distXZ, terrainSpacing(distXZ, pc.lodPixels, pc.projScale), pc.factor, pc.terrainSize);
	groundY -= meshSag(heightmap, uv, terrainSpacing(dist, pc.lodPixels, pc.projScale), pc.factor, pc.terrainSize);
	GroundCoverInstance instance;
	instance.posScale = vec4(xz.x, groundY - 0.002, xz.y, scale);
	const float sway[GC_SPECIES] = float[](1.0, 0.0, 0.35, 0.5, 0.8, 0.4, 0.6, 1.0, 1.0, 0.8, 1.0, 0.9, 0.8, 0.4);
	instance.params = vec4(rnd2.z * 6.2831853, clamp(data.g * 0.6 + rnd2.y * 0.4, 0.0, 1.0), rnd2.w, sway[kind]);

	// shadows from the plants big enough to cast one that shows (each plant to its own distance, so the edge of
	// the shadows doesn't move as a ring)
	bool caster = kind == GC_FERN || kind == GC_SHRUB || kind == GC_BUSH || kind == GC_NETTLE || kind == GC_BRANCHES || kind == GC_ROOIBOS;
	float shadowReach = GC_SHADOW_DISTANCE * (kind == GC_SHRUB || kind == GC_ROOIBOS ? 2.0 : 1.0) * mix(0.6, 1.0, keep);
	if (caster && dist < shadowReach) append(uint(GC_MAX_MESHES) + mesh, instance);

	float sphere = sp.size.x * scale;
	vec4 clip = pc.viewproj * vec4(instance.posScale.xyz + vec3(0.0, sphere * 0.5, 0.0), 1.0);
	float margin = sphere * 1.5 + 0.02; // (+ the wind's sway)
	if (clip.w < -margin || abs(clip.x) > clip.w + margin || abs(clip.y) > clip.w + margin) return;
	append(mesh, instance);
}
