#include "biometools.glsl"
#include "heightmapscale.glsl"

layout (local_size_x = 16, local_size_y = 16) in;

layout (r16, set = 0, binding = 0) uniform writeonly image2D heightmap; // R16 unorm: the height, 0..1
// rgb = climate (temperature, moisture, ruggedness) 0..1, half resolution: it's smooth over kilometres (terrain.frag,
// the trees, grass and rocks, the weather on the ground read it). it used to share an RGBA16 texel with the height,
// 302 MB at 6144^2, these two are ~112 MB
layout (rgba8, set = 0, binding = 1) uniform writeonly image2D climateMap;

layout ( push_constant ) uniform constants {
    ivec2 offset;
	ivec2 dirtyMin;
	ivec2 updateSize;
} pc;

#define TAU 6.28318530717959

vec2 hash(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(.1031, .1030, .0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.xx + p3.yz) * p3.zy) * 2.0 - 1.0;
}

vec3 noised(vec2 p) { // fast noise with derivatives
    vec2 i = floor(p);
    vec2 f = fract(p);
    
    vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    vec2 du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
    
    vec2 ga = hash(i + vec2(0.0, 0.0));
    vec2 gb = hash(i + vec2(1.0, 0.0));
    vec2 gc = hash(i + vec2(0.0, 1.0));
    vec2 gd = hash(i + vec2(1.0, 1.0));
    
    float va = dot(ga, f - vec2(0.0, 0.0));
    float vb = dot(gb, f - vec2(1.0, 0.0));
    float vc = dot(gc, f - vec2(0.0, 1.0));
    float vd = dot(gd, f - vec2(1.0, 1.0));

    return vec3(va + u.x * (vb - va) + u.y * (vc - va) + u.x * u.y * (va - vb - vc + vd),
        ga + u.x * (gb - ga) + u.y * (gc - ga) + u.x * u.y * (ga - gb - gc + gd) +
        du * (u.yx * (va - vb - vc + vd) + vec2(vb, vc) - va));
}

float simplex(vec2 p) {
    const float K1 = 0.366025404; // (sqrt(3)-1)/2;
    const float K2 = 0.211324865; // (3-sqrt(3))/6;

	vec2  i = floor( p + (p.x+p.y)*K1 );
    vec2  a = p - i + (i.x+i.y)*K2;
    float m = step(a.y,a.x); 
    vec2  o = vec2(m,1.0-m);
    vec2  b = a - o + K2;
	vec2  c = a - 1.0 + 2.0*K2;
    vec3  h = max( 0.5-vec3(dot(a,a), dot(b,b), dot(c,c) ), 0.0 );
	vec3  n = h*h*h*h*vec3( dot(a,hash(i+0.0)), dot(b,hash(i+o)), dot(c,hash(i+1.0)));
    return dot( n, vec3(70.0) );
}

float fbm(vec2 p, int octaves) {
	float result = 0.0;
	float freq = 1.0;
	float ampl = 1.0;
	float normalization = 0.0;
	for (int i = 0; i < octaves; i++) {
		result += simplex(p * freq) * ampl;
		normalization += ampl;
	
		freq *= 2.0;
		ampl *= 0.5;
	}
	
	return result / normalization;
}

vec3 FractalNoise(vec2 p, float freq, int octaves, float lacunarity, float gain) {
    vec3 n = vec3(0.0);
    float nf = freq;
    float na = 1.0;
    for (int i = 0; i < octaves; i++) {
        n += noised(p * nf) * na * vec3(1.0, nf, nf);
        na *= gain;
        nf *= lacunarity;
    }
    return n;
}

// ------------------------------------------------------------------ erosion
// the erosion filter from Rune Skovbo Johansen's fork of Fewes' "Terrain Erosion Noise" (shadertoy 7ljcRW), itself
// a fork of Clay John's "Eroded Terrain Noise" (shadertoy MtGcWh). gullies are sine stripes running down the
// slope in Voronoi-like cells, each octave bending the slope the next one follows, so they branch.
//
