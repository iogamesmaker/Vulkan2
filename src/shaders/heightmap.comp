// erosion parameters (p units: the loaded world is 4 across, heights 0..1, so both axes use the same units)
#define EROSION_SCALE 0.08333		 // the overall scale, roughly a mountain's width / 5-10
#define EROSION_STRENGTH 0.16		 // gully depth relative to the scale, 0-0.5 works (the mountains get this)
#define EROSION_SLOPE_POWER 0.6		 // 1 = smooth peaks and ridges, 0.5 = sharper
#define EROSION_CELL_SCALE 1.0		 // gully cell size relative to the scale: smaller = grainier, bigger = longer
#define EROSION_HEIGHT_OFFSET -0.5	 // -1 only lowers the terrain, 1 only raises it
#define EROSION_OCTAVES 6			 // the 6th: ~25m gullies, still more than twice the heightmap's 9m texels
#define EROSION_GAIN 0.5
#define EROSION_LACUNARITY 2.0

// gullies (height and slope) running along the input slope, amplitude 1. steeper slopes get higher frequency
// gullies, flat ground (peaks) none: cos() puts the wave's maximum there
vec3 Gullies(in vec2 p, vec2 slope) {
	vec2 sideDir = slope.yx * vec2(-1.0, 1.0) * TAU; // orthogonal to the slope, 2 pi front loaded
	vec2 pInt = floor(p);
	vec2 pFrac = fract(p);
	vec3 heightAndSlope = vec3(0.0);
	float weightSum = 0.0;
	for (int i = -1; i <= 2; i++) {
		for (int j = -1; j <= 2; j++) {
			vec2 gridOffset = vec2(i, j);
			vec2 randomOffset = hash(pInt + gridOffset) * 0.5;
			vec2 vectorFromCellPoint = pFrac - gridOffset - randomOffset;
			// bell shaped, 1 at the cell point and 0 at 1.5 (the closest a cell outside the 4x4 can be)
			float sqrDist = dot(vectorFromCellPoint, vectorFromCellPoint);
			float weight = max(0.0, exp(-sqrDist * 2.0) - 0.01111);
			weightSum += weight;
			float waveInput = dot(vectorFromCellPoint, sideDir);
			heightAndSlope += vec3(cos(waveInput), -sin(waveInput) * sideDir) * weight;
		}
	}
	return heightAndSlope / weightSum;
}

// fbm-like erosion: every octave adds gullies along the current slope, which bends the slope for the next one.
// returns the change in height and slope
vec3 Erosion(in vec2 p, vec3 heightAndSlope, float scale, float strength, float slopePower,
			 float cellScale, int octaves, float gain, float lacunarity) {
	vec3 inputHeightAndSlope = heightAndSlope;
	float freq = 1.0 / (scale * cellScale);
	strength *= scale;
	for (int i = 0; i < octaves; i++) {
		// the slope's length raised to slopePower for the gullies only, the real slope is untouched
		float sqrLen = dot(heightAndSlope.yz, heightAndSlope.yz);
		vec2 inputSlope = heightAndSlope.yz * pow(max(sqrLen, 1e-20), 0.5 * (slopePower - 1.0));
		heightAndSlope += Gullies(p * freq, inputSlope * cellScale) * strength * vec3(1.0, freq, freq);
		strength *= gain;
		freq *= lacunarity;
	}
	return heightAndSlope - inputHeightAndSlope;
}

// the extent of layered noise whose first layer is 1 and every next one gain times that (geometric series)
float MagnitudeSum(int octaves, float gain) {
	return (1.0 - pow(gain, float(octaves))) / (1.0 - gain);
}

// height after erosion at strength times EROSION_STRENGTH, with the EROSION_HEIGHT_OFFSET shift
float erodedHeight(vec2 p, vec3 heightAndSlope, float strength) {
	if (strength <= 0.0) return heightAndSlope.x;
	vec3 h = Erosion(p, heightAndSlope, EROSION_SCALE, strength, EROSION_SLOPE_POWER, EROSION_CELL_SCALE,
					 EROSION_OCTAVES, EROSION_GAIN, EROSION_LACUNARITY);
	float offset = EROSION_SCALE * strength * MagnitudeSum(EROSION_OCTAVES, EROSION_GAIN) * EROSION_HEIGHT_OFFSET;
	return heightAndSlope.x + h.x + offset;
}


// the lowlands' small rolling relief on top of the base hills (~900m across)
float undulation(vec2 p) {
	return fbm(p * 10.0 + vec2(4.2, 7.7), 3) * 0.04;
}

// extra: height + slope (d/dp) added to the base noise before it's eroded, so it gets gullies too
// the base hills: height (0..1) + slope (d/dp), before any erosion
vec3 baseNoise(vec2 p) {
	const float HEIGHT_FREQUENCY = 3.0;
	const float HEIGHT_AMP = 1.0;
	const int HEIGHT_OCTAVES = 3;
	const float HEIGHT_LACUNARITY = 2.0;
	const float HEIGHT_GAIN = 0.1;

	vec3 n = FractalNoise(p, HEIGHT_FREQUENCY, HEIGHT_OCTAVES, HEIGHT_LACUNARITY, HEIGHT_GAIN) * HEIGHT_AMP;
	return n * 0.5 + vec3(0.5, 0.0, 0.0); // [-1, 1] -> [0, 1], the slope halved with it
}

// the base hills with the undulation on them, both eroded together: the undulation used to be added afterwards and
// its smooth blobs sat on top of the gullies, which read as lumpy instead of weathered. u = undulation(p)
float getLowlandHeight(vec2 p, vec3 base, float u, float erosion) {
	const float E = 0.0015; // ~1.5 heightmap texels
	vec3 extra = vec3(u, (undulation(p + vec2(E, 0.0)) - u) / E, (undulation(p + vec2(0.0, E)) - u) / E);
	return erodedHeight(p, base + extra, EROSION_STRENGTH * erosion);
}

// smooth maximum (polynomial), k = how far apart a and b blend
float smax(float a, float b, float k) {
	float h = max(k - abs(a - b), 0.0) / k;
	return max(a, b) + h * h * k * 0.25;
}

// ------------------------------------------------------------------ mountains

// the smooth base noise through the erosion filter at full strength, nothing else: the shadertoy's terrain (and the
// first heightmap here). a ridged multifractal added on top and eroded from finite difference slopes looked worse,
// lumpy crests with the gullies fighting the ridges
float getMountainHeight(vec2 p, vec3 base) {
	return erodedHeight(p, base, EROSION_STRENGTH);
}

// ------------------------------------------------------------------ biomes

// slowly varying climate, low frequency so biomes are big and temperature can't jump (taiga next to desert)
vec3 climateAt(vec2 p) {
	// p spans 4 units across the loaded world, so these are biomes roughly the size of what you can see.
	// two octaves only (more just chops regions into patches) plus a domain warp so borders aren't blobs
	vec2 warp = vec2(fbm(p * 0.15 + vec2(3.7, 9.1), 2), fbm(p * 0.15 + vec2(-8.3, 2.4), 2)) * 2.5;
	vec2 q = p + warp;

	float temperature = fbm(q * 0.07 + vec2(17.3, -41.7), 2) * 1.3 + 0.5;
	float moisture	  = fbm(q * 0.09 + vec2(-93.1, 12.9), 2) * 1.3 + 0.5;
	float ruggedness  = fbm(q * 0.11 + vec2(55.5, 77.2), 2) * 1.4 + 0.5;
	return clamp(vec3(temperature, moisture, ruggedness), 0.0, 1.0);
}

// dunes from warped ridged noise, stretched a bit across the wind so they read as dune fields
// (a sine along the wind made perfectly straight parallel lines)
float dunes(vec2 p) {
	vec2 wind = normalize(vec2(0.8, 0.35));
	vec2 side = vec2(-wind.y, wind.x);
	vec2 q = vec2(dot(p, wind) * 1.0, dot(p, side) * 0.45) * 22.0; // crests run across the wind, longer than they're wide
	q += vec2(simplex(q * 0.18 + 4.1), simplex(q * 0.18 - 7.3)) * 2.5;  // bend them

	float ridges = 0.0;
	float amplitude = 0.65;
	for (int i = 0; i < 2; i++) {
		float r = 1.0 - abs(simplex(q));
		ridges += r * r * amplitude;
		q = q * 2.1 + 13.7;
		amplitude *= 0.45;
	}
	return ridges;
}

// the erosion filter carves gullies down every slope. the lowlands get it as strongly as the mountains (relative to
// their relief, which is scaled down per biome in lowlandMix), except the farmland (soil), which stays smooth. at 0.4
// the rolling hills were smooth blobs
#define LOWLAND_EROSION 1.4 // times EROSION_STRENGTH (0.22). at 2.0 the gullies' walls cut long narrow scarps along the hillsides

// the lowland biomes' shapes mixed by their cover. h = the eroded hills, hSmooth = without erosion (the farmland),
// dune = the desert's dunes on top
float lowlandMix(float cover[BIOME_COUNT], float h, float hSmooth, float dune) {
	const float baseLevel = 0.3;
	return cover[BIOME_PLAINS] * (baseLevel + (h - 0.5) * 0.25)				 // gentle rolling grassland
		 + cover[BIOME_WHEAT]  * (baseLevel - 0.02 + (hSmooth - 0.5) * 0.07)	 // nearly flat farmland, not eroded
		 + cover[BIOME_DESERT] * (baseLevel + (h - 0.5) * 0.08 + dune)		 // flat with low dunes
		 + cover[BIOME_TAIGA]  * (baseLevel + 0.03 + (h - 0.5) * 0.4)		 // hilly forest
		 + cover[BIOME_SNOW]   * (baseLevel + 0.05 + (h - 0.5) * 0.35);		 // tundra
}

// base = baseNoise(p). work that can't change the result is skipped: the lowland under full mountains (it cancels
// out), the dunes outside the desert, the mountains outside the mountains
float getHeight(vec2 p, vec3 climate, vec3 base) {
	float mountains = mountainShapeWeight(climate);
	if (mountains >= 1.0) return getMountainHeight(p, base);

	// the lowland biomes from the ground cover alone, the mountains are raised out of them below
	float cover[BIOME_COUNT];
	groundCover(climate, true, cover);

	float u = undulation(p);
	float hSmooth = base.x + u;
	float h = getLowlandHeight(p, base, u, LOWLAND_EROSION);

	float lowland = lowlandMix(cover, h, hSmooth, cover[BIOME_DESERT] > 0.0 ? dunes(p) * 0.017 : 0.0);
	if (mountains <= 0.0) return lowland;

	// the mountains rise out of the lowland instead of a straight crossfade between the two (that was a ramp with the
	// mountains' valleys showing as pits in it). at the edge only what stands above the lowland counts, a smooth max
	// so it doesn't crease, so the foothills are the massif's tops poking through; full mountains keep their valleys
	float relief = getMountainHeight(p, base) - lowland; // 0..1, the eroded noise's own range
	relief = mix(smax(relief, 0.0, 0.06), relief, mountains * mountains);
	return lowland + mountains * relief;
}

// ------------------------------------------------------------------ the lowlands' flat look

// the valley floor: every lowland biome's shape from the smooth base noise only, the slow trend of the land
float valleyFloor(float weights[BIOME_COUNT], float baseHeight) {
	return lowlandMix(weights, baseHeight, baseHeight, 0.0) / (1.0 - weights[BIOME_MOUNTAINS] + 1e-4);
}

// the integral of smoothstep(0, w, t) from 0 to d (d >= 0): (u^3 - u^4 / 2) w inside the ramp, linear after it
float smoothstepIntegral(float d, float w) {
	float u = clamp(d / w, 0.0, 1.0);
	return w * (u * u * u - 0.5 * u * u * u * u) + max(d - w, 0.0);
}

// the lowlands pulled towards a few metres above the valley floor: their flat look, wide flat floors the hills rise
// out of. the height above the flat level goes through a curve whose slope runs smoothly from FLOOR_SLOPE (on the
// floor) to 1 (from FLOOR_BAND above it): every slope is kept between those, so nothing gets steeper than it was.
// (the old version clipped the band 0.03-0.06 above the valley down to the flat level with a steep fade: every hill
// got a cliff at that height, rings of black scarps along the contours, and a hard threshold filling the pits added
// steps of its own)
float flattenLowland(float height, float weights[BIOME_COUNT], float valley) {
	const float FLOOR_SLOPE = 0.2;	// how much of the relief the floors keep
	const float FLOOR_BAND = 0.07;	// heights above the flat level the curve eases back to the full slope over
	float lowland = 1.0 - weights[BIOME_MOUNTAINS];
	float strength = lowland * lowland * (1.0 - weights[BIOME_DESERT] * 0.7);
	float flatLevel = valley + 0.003;
	float d = height - flatLevel;
	// above: from the floor's slope back to the full one (high ground ends up FLOOR_BAND * 0.4 lower, the same
	// everywhere, so its shape is untouched). below (hollows): the floor's slope, so they mostly fill in
	float flattened = flatLevel + (d >= 0.0 ? FLOOR_SLOPE * d + (1.0 - FLOOR_SLOPE) * smoothstepIntegral(d, FLOOR_BAND) : FLOOR_SLOPE * d);
	return mix(height, flattened, strength);
}

void main() {
	ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy) + pc.dirtyMin;
	ivec2 size = imageSize(heightmap);
	if (gl_GlobalInvocationID.x >= pc.updateSize.x ||  gl_GlobalInvocationID.y >= pc.updateSize.y) return;

	vec2 worldPos = vec2(ivec2(gl_GlobalInvocationID.xy) + pc.offset);
	vec2 p = vec2(worldPos * 4.0) / size;

	vec3 climate = climateAt(p);
	vec3 base = baseNoise(p);
	float height = getHeight(p, climate, base);

	float weights[BIOME_COUNT];
	biomeWeights(climate, weights);
	height = flattenLowland(height, weights, valleyFloor(weights, base.x));
	height = clamp(height, 0.0, 1.0);

	ivec2 physicalCoord = (texelCoord % size + size) % size;

	imageStore(heightmap, physicalCoord, vec4(height));
	// the climate map's texel is the 2x2 whose even corner this is (every strip the map updates spans whole rows / columns)
	if (((physicalCoord.x | physicalCoord.y) & 1) == 0) imageStore(climateMap, physicalCoord / 2, vec4(climate, 0.0));
}
