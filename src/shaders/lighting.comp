#version 450
// deferred lighting: one thread per pixel reads the G-buffer (gbuffer.glsl) and does everything the materials used
// to do in their fragment shaders: sun / moon light through the atmosphere, the cascaded (PCSS) shadow lookup, sky
// ambient with the heightmap's horizon AO, aerial perspective and the fog at the edge of the world. once per
// pixel, no 2x2 quad waste and no overdraw. writes the same two images the forward pass did: the HDR colour
// (ambient + aerial) and the direct light with its shadow term, which shadowresolve.comp blurs and adds.
// sky pixels (depth 0) are left to the sky pass

layout(local_size_x = 8, local_size_y = 8) in;

#include "gbuffer.glsl"

layout(set = 0, binding = 0) uniform sampler2D gbufferAlbedo;
layout(set = 0, binding = 1) uniform sampler2D gbufferNormal;
layout(set = 0, binding = 2) uniform sampler2D gbufferMaterial;
layout(set = 0, binding = 3) uniform sampler2D depthBuffer;
layout(rgba16f, set = 0, binding = 4) uniform image2D colorImage; // read where the sky pass drew (the shafts go on top)
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D directImage; // sun / moon light + shadow
layout(set = 0, binding = 6) uniform sampler2D skyVisibility; // horizon AO, half (or full) the heightmap's resolution, wraps
layout(set = 0, binding = 8) uniform sampler2D cloudTexture; // half resolution (clouds.comp): rgb in-scattered, a = transmittance
layout(set = 0, binding = 12) uniform sampler2D heightmapClimate; // the heightmap (its size: the map offset is in its texels), wraps
layout(set = 0, binding = 11) uniform sampler2D climateMap; // heightmap.comp: rgb = climate (temperature, moisture, ruggedness), half resolution, wraps
layout(set = 0, binding = 7) uniform sampler2D ssaoTexture;	 // half resolution (ssao.comp): r = AO

layout(set = 1, binding = 0) uniform sampler2D transmittanceLUT;
layout(set = 1, binding = 2) uniform sampler2D skyviewLUT;
layout(set = 1, binding = 3) uniform sampler3D aerialLUT;
layout(set = 1, binding = 7) uniform sampler3D volumetricFog;
layout(set = 1, binding = 8) uniform sampler3D aerialSunLUT; // aeriallut.comp: the sun's single scattering part of aerialLUT // volfog_integrate.comp: rgb in-scattered, a = transmittance

#define ATMOSPHERE_SET 1
#define ATMOSPHERE_BINDING 4
#include "atmosphere.glsl"
#include "volfog.glsl"
#include "composite.glsl"

layout(set = 0, binding = 9) uniform sampler2D cloudCoverageMap; // cloudmap.comp
layout(std140, set = 0, binding = 10) uniform CloudMapInfo { vec4 cloudMapInfo; }; // xy centre (km), z extent, w valid
#define CLOUD_COVERAGE_MAP
#include "clouds.glsl"
#include "volclouds.glsl" // cloudShadow

#define SHADOW_PIXEL vec2(gl_GlobalInvocationID.xy) // no gl_FragCoord in compute
#include "shadowsampling.glsl" // set 2

layout(push_constant) uniform constants {
	mat4 invViewProj;  // terrain space (the space the geometry is drawn in)
	mat4 viewProj;	   // for the contact shadow rays
	vec3 campos;
	float terrainSize; // world units covered by the heightmap
	vec3 sundir;
	float frame;	   // noise rotation, TAA averages it
	ivec2 mapOffset;   // heightmap texel offset, for the horizon AO lookup (same as the terrain's)
	vec2 cloudWind;	   // km the clouds have drifted
	vec4 effects;	   // x = contact shadows, y = unused, z = SSAO, w = bounce light strength (0 = off)
	vec4 extra;		   // z = 1: denoise the SSAO (x, y, w unused)
} pc;

// bark is a dielectric, ~4% reflectance head on
const float BARK_F0 = 0.04;

// Cook-Torrance (GGX + height correlated Smith) specular and a Lambert diffuse that only gets the light the
// specular didn't reflect. returns the outgoing radiance per unit of incoming light, cosine included
vec3 barkBRDF(vec3 N, vec3 V, vec3 L, vec3 albedo, float roughness) {
	float NdotL = max(dot(N, L), 0.0);
	if (NdotL <= 0.0) return vec3(0.0);
	vec3 H = normalize(V + L);
	float NdotV = max(dot(N, V), 1e-4), NdotH = max(dot(N, H), 0.0);
	float a = roughness * roughness;
	float a2 = a * a;
	float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
	float D = a2 / (PI * d * d);
	float visibility = 0.5 / (NdotL * sqrt(NdotV * NdotV * (1.0 - a2) + a2) + NdotV * sqrt(NdotL * NdotL * (1.0 - a2) + a2));
	float F = BARK_F0 + (1.0 - BARK_F0) * pow(1.0 - max(dot(H, V), 0.0), 5.0);
	return (albedo / PI * (1.0 - F) + vec3(D * visibility * F)) * NdotL;
}


// diffuse with a wrap: 0 = lambert (terrain, rocks), thin translucent things let some light round the terminator
// (grass a little, leaf canopies more). the same model for all, so the ground, the grass on it and the trees
// next to it react to the sun the same way
float wrapDiffuse(vec3 n, vec3 l, float wrap) {
	return max((dot(n, l) + wrap) / (1.0 + wrap), 0.0);
}

float interleavedNoise(vec2 p) {
	return fract(52.9829189 * fract(dot(p + pc.frame * 5.588238, vec2(0.06711056, 0.00583715))));
}

// a short screen space ray towards the light through the depth buffer: the small shadows right where things meet
// the ground (tree roots, rocks, grass) that the shadow map is far too coarse for
float contactShadow(vec3 position, vec3 normal, vec3 lightDir, float dist, vec2 size) {
	const int STEPS = 10;
	// how big a pixel is out there: the start offset and the depth bias scale with it, a fixed bias let the
	// surface itself (its neighbouring pixels a hair closer) count as an occluder: dark speckles on every slope
	float pixelWorld = dist * 1.4 / size.y; // 2 tan(35 degrees) / height
	float rayLength = clamp(dist * 0.012, 0.03, 0.35); // world units, grows with distance like the pixels do
	float thickness = rayLength * 1.5;
	float bias = pixelWorld * 1.5;
	float jitter = interleavedNoise(vec2(gl_GlobalInvocationID.xy));
	vec3 start = position + normal * pixelWorld * 2.0;
	// the projection is linear in clip space: project the ray's start and step once instead of every step
	vec4 clipStart = pc.viewProj * vec4(start, 1.0);
	vec4 clipStep = pc.viewProj * vec4(lightDir * (rayLength / float(STEPS)), 0.0);
	for (int i = 1; i <= STEPS; i++) {
		vec4 clip = clipStart + clipStep * (float(i) - jitter);
		vec3 ndc = clip.xyz / clip.w;
		vec2 uv = ndc.xy * 0.5 + 0.5;
		if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) break;
		float sceneDepth = texelFetch(depthBuffer, ivec2(uv * size), 0).r;
		// reversed z: view distance ~ near / depth, the scene is in front of the ray but not by more than thickness
		float rayZ = 0.02 / max(ndc.z, 1e-7), sceneZ = 0.02 / max(sceneDepth, 1e-7);
		float behind = rayZ - sceneZ;
		// soft: an occluder right next to the point darkens most, further along the ray less, never fully black
		// (the shadow map still does the big shadows)
		if (behind > bias && behind < thickness) return mix(0.3, 1.0, float(i - 1) / float(STEPS));
	}
	return 1.0;
}

// an effect texture (ssao.comp, clouds.comp) at this pixel. full resolution reads it directly; lower
// resolution is upsampled depth aware: of the 4 nearest texels only the ones at this pixel's depth count (bilinear
// blending across an edge put the occlusion of what's behind onto leaves). the sky passes SKY_VIEW_Z. when none of
// the 4 match (a twig thinner than a texel) the closest in depth is used, not the fallback: that flickered as the
// jitter moved the twig on and off the texels
const float SKY_VIEW_Z = 0.02 / 1e-7; // what the reversed depth 0 (the sky) turns into below
vec4 upsampleEffect(sampler2D tex, ivec2 p, vec2 screenUV, float viewZ, vec4 fallback) {
	vec2 texSize = vec2(textureSize(tex, 0));
	vec2 fullSize = vec2(textureSize(depthBuffer, 0));
	ivec2 ratio = max(ivec2(round(fullSize / texSize)), ivec2(1));
	if (ratio == ivec2(1)) return texelFetch(tex, min(p, ivec2(texSize) - 1), 0);
	vec2 pos = screenUV * texSize - 0.5;
	ivec2 base = ivec2(floor(pos));
	vec2 f = pos - vec2(base);
	vec4 sum = vec4(0.0), closest = fallback;
	float weightSum = 0.0, closestDiff = 1e30;
	for (int i = 0; i < 4; i++) {
		ivec2 o = ivec2(i & 1, i >> 1);
		ivec2 q = clamp(base + o, ivec2(0), ivec2(texSize) - 1);
		float sampleZ = 0.02 / max(texelFetch(depthBuffer, q * ratio, 0).r, 1e-7);
		float bilinear = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
		float diff = abs(sampleZ - viewZ);
		float w = (bilinear + 1e-3) * exp(-diff / (viewZ * 0.03));
		vec4 c = texelFetch(tex, q, 0);
		sum += c * w;
		weightSum += w;
		if (diff < closestDiff) { closestDiff = diff; closest = c; }
	}
	return weightSum > 1e-4 ? sum / weightSum : closest;
}

// the SSAO (rg) denoised as it's upsampled: a depth aware 3x3 of its texels (6x6 pixels at half resolution) instead
// of the nearest 4. it rotates its samples per pixel (interleaved gradient noise), which averages out over a few
// neighbours, so this takes most of the grain out before the TAA instead of leaving it all to the history
vec2 denoiseSSAO(vec2 screenUV, float viewZ) {
	vec2 texSize = vec2(textureSize(ssaoTexture, 0));
	vec2 fullSize = vec2(textureSize(depthBuffer, 0));
	ivec2 ratio = max(ivec2(round(fullSize / texSize)), ivec2(1));
	ivec2 centre = ivec2(floor(screenUV * texSize));
	vec2 ssaoSum = vec2(0.0);
	float wSum = 0.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			float spatial = (x == 0 ? 1.0 : 0.6) * (y == 0 ? 1.0 : 0.6);
			ivec2 q = clamp(centre + ivec2(x, y), ivec2(0), ivec2(texSize) - 1);
			float z = 0.02 / max(texelFetch(depthBuffer, q * ratio, 0).r, 1e-7);
			float w = spatial * exp(-abs(z - viewZ) / (viewZ * 0.03)) + 1e-5;
			ssaoSum += texelFetch(ssaoTexture, q, 0).rg * w;
			wSum += w;
		}
	}
	return ssaoSum / wSum;
}

// smooth value noise for the weather's patches (snow, puddles)
float weatherHash(vec2 c) {
	vec3 p3 = fract(vec3(c.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}
float weatherValueNoise(vec2 x) {
	vec2 i = floor(x), f = fract(x);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(weatherHash(i), weatherHash(i + vec2(1, 0)), u.x), mix(weatherHash(i + vec2(0, 1)), weatherHash(i + vec2(1, 1)), u.x), u.y);
}

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(colorImage);
	if (any(greaterThanEqual(p, size))) return;

	float depth = texelFetch(depthBuffer, p, 0).r;
	bool volumetricClouds = ubo.clouds > 0.5 || ubo.volumetricFog > 0.5; // clouds.comp ran (the far fog too)
	if (depth <= 0.0) {
		// sky (reversed z): the sky pass drew it, the cumulus go on top
		vec2 uv = (vec2(p) + 0.5) / vec2(size);
		vec4 sky = imageLoad(colorImage, p);
		// the overcast sky: grey and dim behind the clouds. lightning lights it up
		sky.rgb = overcastSky(sky.rgb / ubo.sunIlluminance) * ubo.sunIlluminance + vec3(0.75, 0.8, 1.0) * ubo.weather.z * ubo.sunIlluminance * 0.02;
		if (volumetricClouds) {
			// depth aware like the surfaces: plain bilinear pulled in the texels whose ray stopped at a tree or a
			// ridge, a halo along every edge that crawled with the jitter
			vec4 cloud = upsampleEffect(cloudTexture, p, uv, SKY_VIEW_Z, vec4(0.0, 0.0, 0.0, 1.0));
			sky.rgb = sky.rgb * cloud.a + cloud.rgb + (1.0 - cloud.a) * lightningGlow(); // lit from inside by the flash
		}
		// the fog in front of the sky: the whole froxel column
		if (ubo.volumetricFog > 0.5) {
			vec4 fog = sampleVolumetricFog(volumetricFog, uv, ubo.fogDistance, ubo.fogDistance);
			sky.rgb = sky.rgb * fog.a + fog.rgb;
		}
		imageStore(colorImage, p, sky);
		return;
	}

	// world position from the depth
	vec2 screenUV = (vec2(p) + 0.5) / vec2(size);
	vec4 world = pc.invViewProj * vec4(screenUV * 2.0 - 1.0, depth, 1.0);
	vec3 position = world.xyz / world.w;

	vec4 albedoAO = texelFetch(gbufferAlbedo, p, 0);
	vec3 albedo = albedoAO.rgb;
	float ao = albedoAO.a;
	vec3 normal = normalize(texelFetch(gbufferNormal, p, 0).xyz);
	vec4 materialData = texelFetch(gbufferMaterial, p, 0);
	int material = int(materialData.r * 255.0 + 0.5);
	float roughness = materialData.g;
	float directScale = materialData.b;

	// the weather on the ground (weather.cpp): fresh snow settling on what faces up, in patches that grow together as
	// it builds up; rain darkening everything it soaks and filling the flat spots with puddles
	vec2 weatherTexels = vec2(textureSize(heightmapClimate, 0));
	// (none of it when it's dry and snowless: the noise and the climate lookup cost every pixel otherwise)
	float weatherNoise = 0.0, snowable = 0.0, soakable = 0.0;
	if (ubo.weather.w > 0.0 || ubo.weather.y > 0.0) {
		vec2 weatherXZ = (position.xz + vec2(pc.mapOffset) * (pc.terrainSize / weatherTexels.x)) * 0.3; // world anchored, ~20m patches
		weatherNoise = weatherValueNoise(weatherXZ) * 0.65 + weatherValueNoise(weatherXZ * 2.7 + 13.1) * 0.35;
		// the weather is the one under the camera, the ground far off has its own climate: no snow settles in a hot desert
		// you look at from the taiga's edge, the desert doesn't soak up a temperate rain
		vec2 climateUV = (position.xz + 0.5 * pc.terrainSize) / pc.terrainSize + vec2(pc.mapOffset) / weatherTexels;
		vec3 climateHere = textureLod(climateMap, climateUV, 0.0).rgb;
		snowable = smoothstep(0.5, 0.36, climateHere.r);
		soakable = 1.0 - smoothstep(0.6, 0.7, climateHere.r) * smoothstep(0.45, 0.33, climateHere.g);
	}
	float snowHere = 0.0;
	if (ubo.weather.w > 0.0) {
		float facingUp = smoothstep(0.35, 0.8, normal.y);
		snowHere = smoothstep(0.25, 0.55, ubo.weather.w * snowable * facingUp * (0.6 + 0.8 * weatherNoise));
		albedo = mix(albedo, vec3(0.8, 0.83, 0.88), snowHere);
		roughness = mix(roughness, 0.6, snowHere);
	}
	float wet = ubo.weather.y * soakable * (1.0 - snowHere);
	float puddle = 0.0;
	if (wet > 0.0) {
		// soaked ground and bark go much darker, leaves and grass a little (they shed it)
		bool porous = material == MAT_TERRAIN || material == MAT_BARK;
		albedo *= mix(1.0, porous ? 0.55 : 0.85, wet);
		// puddles on flat ground: grow from the low spots of the noise as it gets wetter
		if (material == MAT_TERRAIN) puddle = smoothstep(0.7, 0.82, weatherNoise + wet * 0.25 - 0.2) * smoothstep(0.95, 0.99, normal.y) * smoothstep(0.5, 0.9, wet);
		albedo *= 1.0 - puddle * 0.5;
	}

	vec3 sunDir = pc.sundir;
	vec3 moonDir = -sunDir;
	vec3 viewDir = normalize(position - pc.campos);
	float dist = distance(position, pc.campos);

	// direct light from the sun and the moon (opposite the sun), coloured by the atmosphere it passes through
	vec3 posKm = vec3(0.0, ubo.radiusbottom + max(ubo.baseAltitude + position.y * ubo.worldScale, PLANET_RADIUS_OFFSET), 0.0);
	vec3 camKm = vec3(0.0, ubo.radiusbottom + max(ubo.baseAltitude + pc.campos.y * ubo.worldScale, PLANET_RADIUS_OFFSET), 0.0);
	vec3 sunLight  = sunTransmittance(transmittanceLUT, posKm, sunDir) * ubo.sunIlluminance;
	vec3 moonLight = sunTransmittance(transmittanceLUT, posKm, moonDir) * ubo.moonIlluminance;

	// only one of them is up at a time, so they share the shadow map. grass cards look it up with an up normal
	vec3 shadowDir = sunDir.y > 0.0 ? sunDir : moonDir;
	float shadow = sampleShadow(position, material == MAT_GRASS ? vec3(0.0, 1.0, 0.0) : normal, shadowDir, dist);

	vec3 direct;
	if (material == MAT_BARK) {
		direct = sunLight * barkBRDF(normal, -viewDir, sunDir, albedo, roughness) + moonLight * barkBRDF(normal, -viewDir, moonDir, albedo, roughness);
	} else if (material == MAT_LEAF || material == MAT_IMPOSTOR) {
		// leaf canopies never go fully dark on the shadow side, and the sun shines through them when backlit
		// (impostors too: they're the same leaves further away, a different response showed as a pop at the switch)
		float backlit = pow(max(dot(viewDir, sunDir), 0.0), 4.0) * 0.4;
		direct = albedo / PI * (sunLight * (wrapDiffuse(normal, sunDir, 0.5) + backlit) + moonLight * wrapDiffuse(normal, moonDir, 0.5));
	} else if (material == MAT_GRASS) {
		// the normal is mostly the ground's (foliage.frag), a small wrap for the thin blades, the same light through
		// them as leaves when backlit (weaker, they're thin) and a soft sheen of their own colour towards the sun
		// light through the blades when the sun is behind them: wider and stronger than before, and tinted like light
		// through a leaf (brighter yellow green), so backlit meadows glow
		float backlit = pow(max(dot(viewDir, sunDir), 0.0), 4.0) * 0.4;
		float sheen = pow(max(dot(normal, normalize(sunDir - viewDir)), 0.0), 24.0) * 0.2;
		vec3 transmitted = albedo * vec3(1.1, 1.35, 0.6);
		direct = albedo / PI * (sunLight * (wrapDiffuse(normal, sunDir, 0.25) + sheen) + moonLight * wrapDiffuse(normal, moonDir, 0.25))
			   + transmitted / PI * sunLight * backlit;
	} else { // terrain
		direct = albedo / PI * (sunLight * wrapDiffuse(normal, sunDir, 0.0) + moonLight * wrapDiffuse(normal, moonDir, 0.0));
	}
	direct *= directScale; // * shadow in shadowresolve.comp
	// the sun / moon handover: the shadow map switches lights while one is right at the horizon (its shadows fade
	// out over the last ~0.7 degrees). the direct light fades out over a wider band around it, so there's never a
	// moment of unshadowed grazing light that then pops into the other light's shadows
	direct *= smoothstep(0.005, 0.05, abs(sunDir.y));
	// only on solid surfaces (terrain, bark, rocks, logs): the alpha tested cards (leaves, grass, impostors) change
	// from pixel to pixel and frame to frame, the short rays turn that into flicker
	bool solid = material == MAT_TERRAIN || material == MAT_BARK;
	if (pc.effects.x > 0.0 && dist < 120.0 && solid && dot(normal, shadowDir) > 0.0)
		direct *= mix(contactShadow(position, normal, shadowDir, dist, vec2(size)), 1.0, smoothstep(80.0, 120.0, dist));

	// cloud shadows drifting over the land: the sun ray from here through the cloud layer (clouds.glsl)
	vec2 heightmapTexels = vec2(textureSize(heightmapClimate, 0));
	vec2 worldKm = (position.xz + vec2(pc.mapOffset) * (pc.terrainSize / heightmapTexels.x)) * ubo.worldScale + pc.cloudWind;
	float clouds = ubo.cloudShadows > 0.5 ? cloudShadow(worldKm, ubo.baseAltitude + position.y * ubo.worldScale, sunDir) : 1.0;
	direct *= mix(vec3(1.0), vec3(clouds), step(0.0, sunDir.y)); // the moon lights through, it's dim anyway

	// the far forests' shade: the trees only cast real shadows out to SHADOW_DISTANCE (treecommon.glsl), past it a
	// forest was lit like open ground, a flat bright green. there the light comes through the canopy map's crown
	// layer (horizonao.comp, g) instead: a few samples of it towards the light, from just above the ground to the
	// crowns' tops. the crowns themselves only get the upper part (their tops are in the sun)
	vec2 canopyUV = (position.xz + 0.5 * pc.terrainSize) / pc.terrainSize + vec2(pc.mapOffset) / heightmapTexels;
	bool crown = material == MAT_LEAF || material == MAT_IMPOSTOR;
	float farShade = smoothstep(130.0, 165.0, dist);
	if (farShade > 0.0 && shadowDir.y > 0.02) {
		vec2 toLight = shadowDir.xz / shadowDir.y; // horizontal run per unit of height
		float through = 0.0;
		for (int i = 0; i < 4; i++) {
			float h = mix(crown ? 1.8 : 0.5, 3.4, (float(i) + 0.5) / 4.0); // world units up (the crowns are ~2-4.5 tall)
			vec2 run = toLight * h;
			run *= min(1.0, 30.0 / max(length(run), 1e-3)); // a low sun: not further than a few tree lengths
			through += texture(skyVisibility, canopyUV + run / pc.terrainSize).g;
		}
		direct *= mix(1.0, 1.0 - through * 0.25 * (crown ? 0.5 : 0.9), farShade);
	}

	// ambient: the sky at the zenith and near the horizon (90 degrees from the sun), blended by how much the
	// normal faces up (the same for every material, grass has the ground's normal mostly), times how much sky the spot sees (horizon AO from
	// the heightmap: valleys, gullies and forests at the foot of cliffs get less)
	vec2 skySize = vec2(textureSize(skyviewLUT, 0));
	vec3 zenith  = texture(skyviewLUT, vec2(0.5, 1.0 - 0.5 / skySize.y)).rgb;
	vec3 horizon = texture(skyviewLUT, vec2(0.25, 0.6)).rgb;
	vec3 skyLight = overcastSky(mix(horizon, zenith, normal.y * 0.5 + 0.5)) * PI * ubo.sunIlluminance; // a grey lid when it's overcast
	// one bounce off the sunlit ground: whatever faces down / sideways picks up the ground's colour, not just sky
	// (the irradiance from a lambert ground with albedo ~0.2 lit by the sun, over the lower hemisphere)
	float facingDown = 0.5 - 0.5 * normal.y;
	// (analytic, the far field: open terrain barely bounces onto itself on screen, most of this comes from ground off
	// screen or far away)
	skyLight += sunLight * max(sunDir.y, 0.0) * vec3(0.2, 0.2, 0.15) * facingDown * pc.effects.w;
	// the moonlit sky: the sky LUT has next to nothing at night, so moon shadows went pitch black. a faint bluish fill
	skyLight += moonLight * max(moonDir.y, 0.0) * vec3(0.1, 0.12, 0.18) * (normal.y * 0.3 + 0.7);
	vec2 heightmapSize = vec2(textureSize(heightmapClimate, 0));
	vec2 heightmapUV = (position.xz + 0.5 * pc.terrainSize) / pc.terrainSize + vec2(pc.mapOffset) / heightmapSize;
	vec2 skyMap = texture(skyVisibility, heightmapUV).rg;
	float skyVisible = skyMap.r;
	// under a forest the crowns hide much of the sky: the floor, the trunks and the grass between them get less of it
	// (the gaps let some through), the crowns a little less (they're the canopy, the outer leaves see the sky)
	float canopySky = 1.0 - skyMap.g * (crown ? 0.3 : 0.75);
	// the AO / shafts and cumulus: half resolution, or full on Ultra (each its own setting)
	float viewZ = 0.02 / depth; // reversed z, ~ view distance
	vec2 halfRes = pc.extra.z > 0.5 ? denoiseSSAO(screenUV, viewZ) : upsampleEffect(ssaoTexture, p, screenUV, viewZ, vec4(1.0)).rg;
	vec4 cloud = volumetricClouds ? upsampleEffect(cloudTexture, p, screenUV, viewZ, vec4(0.0, 0.0, 0.0, 1.0)) : vec4(0.0);
	float ssao = pc.effects.z > 0.0 ? halfRes.r : 1.0;
	if (material == MAT_GRASS) ssao = mix(1.0, ssao, 0.25); // foliage: mostly its own root darkening, the noise flickers on thin cards
	vec3 color = albedo / PI * skyLight * ao * ssao * skyVisible * skyVisible * canopySky * mix(0.8, 1.0, clouds); // a little less sky under a cloud
	// lightning: the whole sky lights up blue-white for an instant, from above
	color += albedo * vec3(0.75, 0.8, 1.0) * ubo.weather.z * ubo.sunIlluminance * 0.12 * (0.35 + 0.65 * max(normal.y, 0.0)) * ao;
	// wet surfaces reflect the sky: a thin sheen everywhere it rained, mirror-like in the puddles
	if (wet > 0.0) {
		vec3 wetNormal = normalize(mix(normal, vec3(0.0, 1.0, 0.0), puddle));
		vec3 R = reflect(viewDir, wetNormal);
		R.y = abs(R.y);
		float F = 0.02 + 0.98 * pow(1.0 - max(dot(wetNormal, -viewDir), 0.0), 5.0);
		// (the sky only, nothing around it: dimmed by how much sky the spot sees, and half again for the hills and
		// trees a real puddle would mirror, or the wet patches read as snow)
		vec3 reflection = overcastSky(texture(skyviewLUT, skyviewUV(camKm, R, sunDir)).rgb) * ubo.sunIlluminance * skyVisible * skyVisible * 0.5;
		color = mix(color, reflection, F * (wet * 0.25 + puddle * 0.6));
	}

	// the atmosphere in front of it (composite.glsl)
	{
		AtmosphereView view;
		view.screenUV = screenUV;
		view.position = position;
		view.campos = pc.campos;
		view.sunDir = sunDir;
		view.cloud = cloud;
		view.clouds = volumetricClouds;
		view.airLit = halfRes.g; // ssao.comp measures it
		color = compositeAtmosphere(color, direct, view);
	}

	imageStore(colorImage, p, vec4(color, 1.0));
	imageStore(directImage, p, vec4(direct, shadow));
}
