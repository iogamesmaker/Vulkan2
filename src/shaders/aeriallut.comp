#version 450
// aerial perspective LUT: a froxel volume aligned with the camera frustum
// xy = screen uv, z = distance slice (slice i ends at (i + 1) / depth * aerialDistance)
// rgb = in-scattered luminance (per unit of sun illuminance, sun + moon), a = mean transmittance
// one thread marches a whole column so every slice reuses the previous one

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, set = 0, binding = 0) uniform image3D aerial;
layout(set = 0, binding = 1) uniform sampler2D transmittance;
layout(set = 0, binding = 2) uniform sampler2D multiscattering;
// rgb = the part of aerial's light that's the sun's / moon's single scattering (the rest is the multiple scattering,
// the skylight in the haze). lighting.comp shadows only this part where the terrain blocks the light
layout(rgba16f, set = 0, binding = 3) uniform image3D aerialSun;

#define ATMOSPHERE_SET 1
#define ATMOSPHERE_BINDING 0
#include "atmosphere.glsl"

layout(push_constant) uniform constants {
	mat4 invViewProj;
	vec3 camPos; // km, planet centred
	float starRotation;
	vec3 sunDir;
	float latitude;
} pc;

const int STEPS_PER_SLICE = 2;

void main() {
	ivec3 size = imageSize(aerial);
	ivec2 texcoord = ivec2(gl_GlobalInvocationID.xy);

	if (texcoord.x >= size.x || texcoord.y >= size.y) return;

	vec2 uv = (vec2(texcoord) + 0.5) / vec2(size.xy);
	vec4 world = pc.invViewProj * vec4(uv * 2.0 - 1.0, 0.5, 1.0);
	vec3 dir = normalize(world.xyz / world.w);

	float cosTheta = dot(dir, pc.sunDir);

	vec3 luminance = vec3(0.0), sunLuminance = vec3(0.0);
	vec3 throughput = vec3(1.0);
	float moonRatio = ubo.moonIlluminance / ubo.sunIlluminance;

	float sliceLength = ubo.aerialDistance / float(size.z);
	float dt = sliceLength / float(STEPS_PER_SLICE);
	float t = 0.0;

	for (int slice = 0; slice < size.z; slice++) {
		for (int s = 0; s < STEPS_PER_SLICE; s++) {
			vec3 samplePos = pc.camPos + (t + 0.5 * dt) * dir;
			t += dt;

			// don't let the terrain dip below the planet surface
			float r = length(samplePos);
			if (r < ubo.radiusbottom + PLANET_RADIUS_OFFSET) samplePos *= (ubo.radiusbottom + PLANET_RADIUS_OFFSET) / r;

			vec3 rayleighScattering, mieScattering, extinction;
			getScatteringValues(samplePos, rayleighScattering, mieScattering, extinction);

			vec3 stepTransmittance = exp(-dt * extinction);
			vec3 scattered = inScattering(transmittance, multiscattering, samplePos, pc.sunDir, cosTheta, rayleighScattering, mieScattering);

			// (inScattering's direct terms on their own: the phase functions times the light reaching this point)
			vec3 sunTrans = sunTransmittance(transmittance, samplePos, pc.sunDir), moonTrans = sunTransmittance(transmittance, samplePos, -pc.sunDir);
			vec3 single = rayleighScattering * (rayleighPhase(cosTheta) * sunTrans + moonRatio * rayleighPhase(-cosTheta) * moonTrans)
						+ mieScattering * (miePhase(cosTheta) * sunTrans + moonRatio * miePhase(-cosTheta) * moonTrans);

			vec3 integrate = throughput * (1.0 - stepTransmittance) / max(extinction, vec3(1e-7));
			luminance += scattered * integrate;
			sunLuminance += single * integrate;
			throughput *= stepTransmittance;
		}

		imageStore(aerial, ivec3(texcoord, slice), vec4(luminance, dot(throughput, vec3(1.0 / 3.0))));
		imageStore(aerialSun, ivec3(texcoord, slice), vec4(sunLuminance, 0.0));
	}
}
